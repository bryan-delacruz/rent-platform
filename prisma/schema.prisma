// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PropertyType {
  ROOM
  COMMERCIAL
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  TERMINATED
  EXPIRED
}

// Every row belongs to one landlord: ownerId is the Clerk user id and every
// query filters by it. Money is Decimal(12,2) and calendar dates are @db.Date.

model Property {
  id       String         @id @default(cuid())
  ownerId  String
  name     String
  type     PropertyType
  status   PropertyStatus @default(AVAILABLE)
  price    Decimal        @db.Decimal(12, 2)
  currency String         @default("PEN")
  location String
  floor    Int

  leases Lease[]

  @@index([ownerId])
  @@map("properties")
}

model Tenant {
  id      String @id @default(cuid())
  ownerId String
  name    String
  email   String
  phone   String
  dni     String
  address String

  leases Lease[]

  @@unique([ownerId, dni])
  @@index([ownerId])
  @@map("tenants")
}

model Lease {
  id              String      @id @default(cuid())
  ownerId         String
  propertyId      String
  tenantId        String
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  monthlyRent     Decimal     @db.Decimal(12, 2)
  currency        String      @default("PEN")
  status          LeaseStatus @default(ACTIVE)
  advanceMonths   Int         @default(0)
  warrantyMonths  Int         @default(0)
  waterCost       Decimal?    @db.Decimal(12, 2)
  electricityCost Decimal?    @db.Decimal(12, 2)
  gasCost         Decimal?    @db.Decimal(12, 2)
  terminationDate DateTime?   @db.Date

  property Property  @relation(fields: [propertyId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@index([ownerId, status])
  @@index([propertyId])
  @@index([tenantId])
  @@map("leases")
}

// A monthly charge. Its status (paid, partial, pending, overdue) is derived
// from the amounts and the due date when read, so it never goes stale.
model Payment {
  id         String   @id @default(cuid())
  ownerId    String
  leaseId    String
  dueDate    DateTime @db.Date
  amount     Decimal  @db.Decimal(12, 2)
  amountPaid Decimal  @default(0) @db.Decimal(12, 2)
  paidDate   DateTime? @db.Date

  lease        Lease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([leaseId, dueDate])
  @@index([ownerId, dueDate])
  @@map("payments")
}

model PaymentTransaction {
  id        String   @id @default(cuid())
  paymentId String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @db.Date
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}
